<Window x:Class="LR3.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Облік поїздок" Height="820" Width="860"
        Background="#FFDBFCBE" FontFamily="Consolas" FontSize="14" FontWeight="Bold">
    <Window.Resources>
        <Style TargetType="Label">
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,3,0,3"/>
            <Setter Property="Padding" Value="3"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="0,3,0,3"/>
            <Setter Property="Padding" Value="3"/>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Нова поїздка -->
        <GroupBox Header="Нова поїздка" Grid.Row="0" Margin="5">
            <StackPanel Margin="10">

                <!-- Спільні поля для всіх типів транспорту -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="230"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Label Grid.Row="0" Grid.Column="0" Content="Тип транспорту:"/>
                    <ComboBox x:Name="VehicleTypeComboBox" Grid.Row="0" Grid.Column="1"
                              Width="220" HorizontalAlignment="Left" SelectedIndex="0"
                              SelectionChanged="VehicleTypeComboBox_SelectionChanged">
                        <ComboBoxItem Content="Автомобіль"/>
                        <ComboBoxItem Content="Мотоцикл"/>
                        <ComboBoxItem Content="Електромобіль"/>
                    </ComboBox>

                    <Label Grid.Row="1" Grid.Column="0" Content="Швидкість (км/год):"/>
                    <TextBox x:Name="SpeedTextBox" Grid.Row="1" Grid.Column="1"/>

                    <Label Grid.Row="2" Grid.Column="0" Content="Час у дорозі (год):"/>
                    <TextBox x:Name="TravelTimeTextBox" Grid.Row="2" Grid.Column="1"/>

                    <Label x:Name="ConsumptionLabel" Grid.Row="3" Grid.Column="0" Content="Витрата (л/100 км):"/>
                    <TextBox x:Name="FuelConsumptionTextBox" Grid.Row="3" Grid.Column="1"/>
                </Grid>

                <!-- Панель автомобіля -->
                <Grid x:Name="CarPanel">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="230"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Label Grid.Column="0" Content="Тип двигуна:"/>
                    <ComboBox x:Name="EngineTypeComboBox" Grid.Column="1"
                              Width="220" HorizontalAlignment="Left" SelectedIndex="0">
                        <ComboBoxItem Content="Бензиновий"/>
                        <ComboBoxItem Content="Дизельний"/>
                        <ComboBoxItem Content="Гібридний"/>
                    </ComboBox>
                </Grid>

                <!-- Панель мотоцикла -->
                <Grid x:Name="MotorcyclePanel" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="230"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Label Grid.Column="0" Content="Клас мотоцикла:"/>
                    <ComboBox x:Name="MotorcycleClassComboBox" Grid.Column="1"
                              Width="220" HorizontalAlignment="Left" SelectedIndex="0">
                        <ComboBoxItem Content="Скутер"/>
                        <ComboBoxItem Content="Круїзер"/>
                        <ComboBoxItem Content="Туристичний"/>
                        <ComboBoxItem Content="Спортивний"/>
                    </ComboBox>
                </Grid>

                <!-- Панель електромобіля -->
                <Grid x:Name="ElectricPanel" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="230"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Label Grid.Column="0" Content="Ємність батареї (кВт·год):"/>
                    <TextBox x:Name="BatteryCapacityTextBox" Grid.Column="1"/>
                </Grid>

                <Button x:Name="AddTripButton" Content="Додати поїздку" Margin="0,15,0,0"
                        HorizontalAlignment="Left" Padding="10,5"
                        Background="#FF4CAF50" Foreground="White"
                        Click="AddTripButton_Click"/>
            </StackPanel>
        </GroupBox>

        <!-- Список поїздок -->
        <GroupBox Header="Список поїздок" Grid.Row="1" Margin="5">
            <ListBox x:Name="TripsListBox" Margin="10"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
        </GroupBox>

        <!-- Аналітика -->
        <GroupBox Header="Аналітика" Grid.Row="2" Margin="5">
            <StackPanel Margin="10">
                <StackPanel Orientation="Horizontal">
                    <Label Content="Ціна пального (грн/л):"/>
                    <TextBox x:Name="FuelPriceTextBox" Width="80" Text="90"
                             TextChanged="PriceTextBox_TextChanged"/>
                    <Label Content="Ціна енергії (грн/кВт·год):" Margin="20,0,0,0"/>
                    <TextBox x:Name="ElectricPriceTextBox" Width="80" Text="8"
                             TextChanged="PriceTextBox_TextChanged"/>
                </StackPanel>
                <TextBlock x:Name="TotalCostTextBlock" Margin="0,8,0,0" TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           Text="Загальна вартість поїздок: 0,00 ₴"/>
                <TextBlock x:Name="MinCostTextBlock" Margin="0,4,0,0" TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           Text="Мінімальна вартість поїздки: -"/>
                <TextBlock x:Name="TotalEmissionTextBlock" Margin="0,4,0,0" TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           Text="Загальні викиди CO₂: 0,0 кг"/>
            </StackPanel>
        </GroupBox>
    </Grid>
</Window>
