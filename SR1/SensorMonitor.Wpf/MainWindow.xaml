<Window x:Class="SensorMonitor.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Моніторинг промислових датчиків (IoT)"
        Height="650" Width="1050" MinHeight="500" MinWidth="850"
        Language="uk-UA"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. Імпорт -->
        <GroupBox Grid.Row="0" Header="1. Імпорт даних з JSON у базу даних" Padding="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="PathTextBox" Grid.Column="0" IsReadOnly="True"
                         VerticalContentAlignment="Center" Margin="0,0,8,0"
                         ToolTip="Шлях до обраного JSON-файлу"/>
                <Button x:Name="BrowseButton" Grid.Column="1" Content="Обрати JSON…"
                        Padding="14,5" Margin="0,0,8,0" Click="BrowseButton_Click"/>
                <Button x:Name="ImportButton" Grid.Column="2" Content="Імпортувати в БД"
                        Padding="14,5" Margin="0,0,8,0" IsEnabled="False" Click="ImportButton_Click"/>
                <Button x:Name="CancelButton" Grid.Column="3" Content="Скасувати"
                        Padding="14,5" IsEnabled="False" Click="CancelButton_Click"/>
            </Grid>
        </GroupBox>

        <!-- Прогрес -->
        <Grid Grid.Row="1" Margin="0,8,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ProgressBar x:Name="BusyBar" Grid.Column="0" Height="16" Minimum="0" Maximum="100"/>
            <TextBlock x:Name="StatusText" Grid.Column="1" Margin="10,0,0,0"
                       VerticalAlignment="Center" TextWrapping="Wrap" Text="Оберіть JSON-файл для імпорту."/>
        </Grid>

        <!-- 2. Аналітика -->
        <GroupBox Grid.Row="2" Header="2. Підсумкова аналітика" Padding="8">
            <WrapPanel VerticalAlignment="Center">
                <Button x:Name="FactorySummaryButton" Content="Зведення по заводах"
                        Padding="12,5" Margin="0,0,8,4" Click="FactorySummaryButton_Click"/>
                <Button x:Name="TypeStatsButton" Content="Статистика за типами датчиків"
                        Padding="12,5" Margin="0,0,8,4" Click="TypeStatsButton_Click"/>
                <Button x:Name="AnomaliesButton" Content="Статистичні аномалії"
                        Padding="12,5" Margin="0,0,4,4" Click="AnomaliesButton_Click"/>
                <TextBlock Text="σ ="  VerticalAlignment="Center" Margin="0,0,4,4"/>
                <TextBox x:Name="SigmaTextBox" Text="2" Width="40" Margin="0,0,16,4"
                         VerticalContentAlignment="Center" ToolTip="Поріг |z| у стандартних відхиленнях"/>
                <Button x:Name="ProblematicButton" Content="Проблемні датчики"
                        Padding="12,5" Margin="0,0,4,4" Click="ProblematicButton_Click"/>
                <TextBlock Text="частка ≥" VerticalAlignment="Center" Margin="0,0,4,4"/>
                <TextBox x:Name="ShareTextBox" Text="30" Width="40" Margin="0,0,4,4"
                         VerticalContentAlignment="Center" ToolTip="Мінімальна частка вимірювань не зі статусом Normal, %"/>
                <TextBlock Text="%" VerticalAlignment="Center" Margin="0,0,0,4"/>
            </WrapPanel>
        </GroupBox>

        <!-- Таблиця результатів -->
        <DataGrid x:Name="ResultsGrid" Grid.Row="3" Margin="0,8,0,0"
                  IsReadOnly="True" AutoGenerateColumns="True"
                  CanUserAddRows="False" CanUserDeleteRows="False"
                  AlternatingRowBackground="#F4F6F8" GridLinesVisibility="Horizontal"
                  AutoGeneratingColumn="ResultsGrid_AutoGeneratingColumn"/>

        <TextBlock x:Name="SummaryText" Grid.Row="4" Margin="0,8,0,0" FontWeight="SemiBold"/>
    </Grid>
</Window>
