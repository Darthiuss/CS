<Window x:Class="Lab6Baggage.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Багажна відомість камери схову" Height="660" Width="950"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Блок додавання запису -->
        <StackPanel Grid.Row="0" Orientation="Vertical" Margin="0,0,0,10">
            <TextBlock Text="Додати запис про багаж" FontWeight="Bold"/>
            <Grid Margin="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="ПІБ пасажира:" VerticalAlignment="Center" Margin="5"/>
                <TextBox x:Name="FullNameTextBox" Grid.Column="1" Margin="5" Padding="2"/>
                <TextBlock Grid.Column="2" Text="Кількість речей:" VerticalAlignment="Center" Margin="5"/>
                <TextBox x:Name="ItemsCountTextBox" Grid.Column="3" Margin="5" Padding="2"/>
                <TextBlock Grid.Column="4" Text="Загальна вага (кг):" VerticalAlignment="Center" Margin="5"/>
                <TextBox x:Name="WeightTextBox" Grid.Column="5" Margin="5" Padding="2"/>
            </Grid>
            <Button x:Name="AddButton" Content="Додати запис" Margin="5" Click="AddButton_Click"/>
        </StackPanel>

        <!-- Таблиця записів -->
        <DataGrid x:Name="BaggageDataGrid" Grid.Row="1"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  Margin="0,0,0,10">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ПІБ пасажира" Binding="{Binding FullName}" Width="*"/>
                <DataGridTextColumn Header="Кількість речей" Binding="{Binding ItemsCount}" Width="Auto"/>
                <DataGridTextColumn Header="Загальна вага (кг)" Binding="{Binding TotalWeight}" Width="Auto"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Панель керування -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="5">
            <TextBlock Text="Вага більша за (кг):" VerticalAlignment="Center" Margin="5"/>
            <TextBox x:Name="FilterWeightTextBox" Width="60" Margin="5" Padding="2"
                     ToolTip="Порожнє поле скидає фільтр"/>
            <Button x:Name="FilterButton" Content="Фільтр" Margin="5" Click="FilterButton_Click"/>
            <Button x:Name="DeleteButton" Content="Видалити" Margin="5" Click="DeleteButton_Click"/>
            <Button x:Name="SortButton" Content="Сортувати за кількістю речей" Margin="5" Click="SortButton_Click"/>
            <Button x:Name="LoadButton" Content="Завантажити" Margin="5" Click="LoadButton_Click"/>
            <Button x:Name="SaveButton" Content="Зберегти" Margin="5" Click="SaveButton_Click"/>
        </StackPanel>

        <!-- Панель LINQ-запитів -->
        <WrapPanel Grid.Row="3" HorizontalAlignment="Center" Margin="0,5,0,5" Background="#FFD7FAB2">
            <TextBlock Text="Пошук за ПІБ:" VerticalAlignment="Center" Margin="5"/>
            <TextBox x:Name="SearchTextBox" Width="150" Margin="5" Padding="2"/>
            <Button x:Name="SearchButton" Content="Пошук" Margin="5" Padding="6,2" Click="SearchButton_Click"/>
            <Button x:Name="UniqueSurnamesButton" Content="Унікальні прізвища" Margin="5" Padding="6,2" Click="UniqueSurnamesButton_Click"/>
            <Button x:Name="HeaviestButton" Content="3 найважчі" Margin="5" Padding="6,2" Click="HeaviestButton_Click"/>
            <Button x:Name="AverageWeightPerItemButton" Content="Середня вага речі" Margin="5" Padding="6,2" Click="AverageWeightPerItemButton_Click"/>
            <Button x:Name="GroupByCountButton" Content="Групування за кількістю речей" Margin="5" Padding="6,2" Click="GroupByCountButton_Click"/>
        </WrapPanel>

        <!-- Статистика відображуваного списку -->
        <Label x:Name="StatsLabel" Grid.Row="4" Margin="5" FontWeight="Bold"
               Content="Максимальна вага: 0 кг | Середня вага: 0 кг"/>
    </Grid>
</Window>
